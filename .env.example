NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/teloscart_dev?schema=public"

# JWT Configuration
JWT_ACCESS_SECRET="teloscart_super_secret_jwt_access_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="teloscart_super_secret_jwt_refresh_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="30d"

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=12

# Frontend URL for CORS
CLIENT_URL="https://www.teloscart.website"

# Cloudflare R2 private object storage
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="paytrackai"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_SIGNED_URL_EXPIRES_IN=300
R2_MAX_FILE_SIZE_MB=10
# Optional only if you later add a custom public/domain CDN; private buckets can leave this empty
R2_PUBLIC_BASE_URL=""

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
