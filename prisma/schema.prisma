// Prisma Schema for TelosCart E-Commerce Backend (https://www.teloscart.website/)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum AdminRole {
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum OrderSource {
  WEBSITE
  FACEBOOK
  PHONE
  ADMIN
}

enum ActivitySeverity {
  INFO
  SUCCESS
  WARNING
  DANGER
}

enum ActivityCategory {
  AUTH
  CATALOG
  ORDERS
  PAYMENTS
  SECURITY
  SETTINGS
}

// ==================== MODELS ====================

// Admin model - back-office administrators for TelosCart
model Admin {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      AdminRole  @default(SUPER_ADMIN)
  phone     String?
  avatar    String?
  status    UserStatus @default(ACTIVE)

  // Relations
  activityLogs ActivityLog[]
  createdOrders Order[]

  // Soft Delete Policy
  isDeleted Boolean    @default(false)
  deletedAt DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("admins")
}

// Customer model - shoppers and registered buyers for TelosCart
model Customer {
  id         String            @id @default(uuid())
  customerId String?           @unique // Unique business identifier e.g. TC-2026-1001
  name       String
  email      String            @unique
  password   String?
  phone      String?           @unique
  avatar     String?
  googleId   String?           @unique
  provider   String            @default("credentials")
  status     UserStatus        @default(ACTIVE)

  // E-commerce address relations
  addresses  CustomerAddress[]

  // Reviews written by this customer
  reviews       Review[]

  // Cart & Wishlist relations
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  // Order relations
  orders        Order[]

  // Soft Delete Policy
  isDeleted  Boolean           @default(false)
  deletedAt  DateTime?

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("customers")
}

// CustomerAddress model - multi-address support for checkout & billing
model CustomerAddress {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String?     // Recipient Name
  phone      String?     // Recipient Phone
  title      String?     // e.g. "Home", "Office", "Other"
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  street     String
  city       String      // District
  area       String?     // Upazila
  union      String?     // Union
  zone       String?     // "inside-dhaka" | "outside-dhaka"
  state      String?
  postalCode String?
  country    String      @default("Bangladesh")

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

// Category model - product hierarchy for storefront navigation and catalog filtering
model Category {
  id                 String        @id @default(uuid())
  name               String
  slug               String     @unique
  description        String?
  icon               String?
  image              String?
  imageKey           String?
  subCategories      SubCategory[]
  products           Product[]
  isActive           Boolean    @default(true)
  isFeaturedHomepage Boolean    @default(false)

  // Soft Delete Policy
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([isActive, isDeleted])
  @@index([isDeleted, createdAt])
  @@index([isDeleted, isActive, createdAt])
  @@index([isFeaturedHomepage])
  @@map("categories")
}

// Brand model - manufacturer/vendor identities for storefront filtering and the
// "Official Brands" marquee. Flat hierarchy on purpose: brands have no children.
model Brand {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  tagline           String? // Official tagline supplied by the storefront form
  description       String?
  image             String?
  imageKey          String?
  products          Product[]
  isActive          Boolean  @default(true)
  isFeaturedMarquee Boolean  @default(false) // Featured in Official Brands Marquee

  // Soft Delete Policy
  isDeleted         Boolean  @default(false)
  deletedAt         DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, isDeleted])
  @@index([isDeleted, createdAt])
  @@index([isDeleted, isActive, createdAt])
  @@index([isFeaturedMarquee])
  @@map("brands")
}

// SubCategory model - child taxonomy under a main category
model SubCategory {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  products    Product[]
  isActive    Boolean  @default(true)

  // Soft Delete Policy
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive, isDeleted])
  @@map("sub_categories")
}

// Product model - catalog items, inventory, badges, vouchers, and variant relations
model Product {
  id                    String          @id @default(uuid())
  name                  String
  slug                  String          @unique
  sku                   String          @unique // Backend-generated: e.g. TC-PRD-2026-1042

  // Pricing & Inventory (Strict Financial Decimal)
  price                 Decimal         @db.Decimal(12, 2)
  originalPrice         Decimal?        @db.Decimal(12, 2) // Regular / strikethrough price
  costPrice             Decimal?        @db.Decimal(12, 2) // Optional internal cost
  stock                 Int             @default(0)
  lowStockThreshold     Int             @default(5)
  stockStatus           StockStatus     @default(IN_STOCK)

  // Storefront Badge (e.g. HOT, SALE, NEW, BESTSELLER)
  showStorefrontBadge   Boolean         @default(false)
  storefrontBadgeText   String?

  // Special Voucher / Promo Discount attached to this item
  hasVoucher            Boolean         @default(false)
  voucherDiscountType   DiscountType?   // PERCENTAGE | FLAT
  voucherDiscountValue  Decimal?        @db.Decimal(12, 2) // e.g. 10 (%) or 100 (৳)
  voucherCouponCode     String?         // e.g. "TELOS10"
  showVoucherBadge      Boolean         @default(false) // Ribbon directly on storefront card

  // Taxonomy & Relations
  categoryId            String
  category              Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategoryId         String?
  subCategory           SubCategory?    @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  brandId               String?
  brand                 Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Media
  thumbnail             String?
  thumbnailKey          String?
  images                ProductImage[]

  // Details
  shortDescription      String?
  description           String?         @db.Text
  specifications        Json?           // Dynamic specs, e.g. { "Material": "Cotton", "Fit": "Regular" }
  warranty              String?         // e.g. "1 Year Official Brand Warranty"

  // SEO Fields
  metaTitle             String?
  metaDescription       String?
  metaKeywords          String?

  // Variants (Color & Size)
  hasVariants           Boolean         @default(false)
  variants              ProductVariant[]

  // Reviews, Cart & Wishlist
  reviews               Review[]
  cartItems             CartItem[]
  wishlistItems         WishlistItem[]
  auditLogs             StockAuditLog[]
  orderItems            OrderItem[]

  // Ratings & Reviews (Denormalized aggregates — updated when Review model is added)
  rating                Float           @default(0) // Average rating 0.0–5.0
  reviewCount           Int             @default(0) // Total number of reviews

  // Flags & Visibility
  isFeatured            Boolean         @default(false)
  isFlashDeal           Boolean         @default(false)
  isActive              Boolean         @default(true)

  // Soft Delete Policy
  isDeleted             Boolean         @default(false)
  deletedAt             DateTime?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([isActive, isDeleted])
  @@index([isDeleted, createdAt])
  @@index([isDeleted, isActive, createdAt])
  @@index([categoryId, isDeleted, createdAt])
  @@index([subCategoryId, isDeleted, createdAt])
  @@index([brandId, isDeleted, createdAt])
  @@index([isFeatured])
  @@index([isFlashDeal])
  @@index([price])
  @@map("products")
}

// ProductImage model - multi-image gallery with R2 keys and ordering
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  key       String
  isThumbnail Boolean @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ProductVariant model - color, size, and weight combinations with dedicated inventory
model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku           String    @unique // e.g. TC-PRD-2026-1042-NAVY-M
  color         String?   // e.g. "Navy Blue", "Red", "#FF0000"
  size          String?   // e.g. "M", "L", "XL", "42"
  weight        String?   // e.g. "250g", "500g", "1kg", "500ml"

  price         Decimal?  @db.Decimal(12, 2) // Selling price
  costPrice     Decimal?  @db.Decimal(12, 2) // Purchase price
  originalPrice Decimal?  @db.Decimal(12, 2)
  stock         Int       @default(0)

  image         String?
  imageKey      String?

  cartItems     CartItem[]
  orderItems    OrderItem[]

  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId])
  @@map("product_variants")
}

// Review model - customer ratings and feedback for products
model Review {
  id                  String    @id @default(uuid())
  productId           String
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  rating              Int       // 1-5 stars
  title               String?   // Optional review headline
  comment             String?   // Full review text

  isVerifiedPurchase  Boolean      @default(false) // Marked if customer purchased this product

  isVisible           Boolean      @default(true) // Storefront visibility
  status              ReviewStatus @default(PUBLISHED) // Moderation status

  isDeleted           Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([productId, customerId]) // One review per customer per product
  @@index([productId])
  @@index([customerId])
  @@index([rating])
  @@index([status])
  @@index([isVisible])
  @@map("reviews")
}

// CartItem model - customer shopping cart line items
model CartItem {
  id          String          @id @default(uuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity    Int             @default(1)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([customerId])
  @@index([productId])
  @@map("cart_items")
}

// WishlistItem model - customer saved wishlist items
model WishlistItem {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("wishlist_items")
}

// StockAuditLog model - immutable audit trail for every warehouse stock modification (+ / -)
model StockAuditLog {
  id            String              @id @default(uuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  actionType    StockAdjustmentType // INCREASE | DECREASE
  quantity      Int                 // Adjustment delta quantity (always positive int e.g. 5, 2)
  previousStock Int                 // Stock balance before adjustment
  newStock      Int                 // Stock balance after adjustment

  reason        String              // Reason category e.g. "RESTOCK", "PURCHASE", "RETURN", "DAMAGED", "STOLEN", "EXPIRED", "CORRECTION", "CUSTOM"
  note          String?             // Optional custom explanation or reference notes
  performedBy   String?             // Admin name or ID who executed the adjustment

  createdAt     DateTime            @default(now())

  @@index([productId])
  @@index([actionType])
  @@index([createdAt])
  @@map("stock_audit_logs")
}

// Order model - customer purchases, invoice generation, status pipeline
model Order {
  id                String                 @id @default(uuid())
  orderNumber       String                 @unique // e.g. TC-94281 (auto-generated in backend)
  customerId        String?
  customer          Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source            OrderSource            @default(WEBSITE)
  createdByAdminId  String?
  createdByAdmin    Admin?                 @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  status            OrderStatus            @default(PENDING)
  paymentStatus     PaymentStatus          @default(UNPAID)

  // Pricing breakdown (Strict Financial Decimals)
  subtotal          Decimal                @db.Decimal(12, 2)
  deliveryFee       Decimal                @default(0) @db.Decimal(12, 2)
  discount          Decimal                @default(0) @db.Decimal(12, 2)
  couponCode        String?
  total             Decimal                @db.Decimal(12, 2)

  // Courier & Delivery Tracking
  trackingNumber    String?
  courierName       String?
  estimatedDelivery String?
  cancelReason      String?

  // Relations
  items             OrderItem[]
  customerDetails   OrderCustomerDetails?
  transactions      OrderTransaction[]

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([customerId])
  @@index([source])
  @@index([createdByAdminId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([status, paymentStatus, createdAt])
  @@map("orders")
}

// OrderItem model - immutable product snapshot at the time of purchase
model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId        String?
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Frozen Product Snapshot (Never affected by subsequent product changes)
  productName      String
  productThumbnail String?
  productSku       String?
  variantName      String?
  unitPrice        Decimal         @db.Decimal(12, 2)
  quantity         Int             @default(1)
  subtotal         Decimal         @db.Decimal(12, 2)

  createdAt        DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// OrderCustomerDetails model - immutable recipient and shipping snapshot at time of checkout
model OrderCustomerDetails {
  id           String   @id @default(uuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  name         String
  phone        String
  email        String?
  street       String
  area         String?
  union        String?
  city         String
  zone         String   @default("inside-dhaka") // "inside-dhaka" | "outside-dhaka"
  postalCode   String?
  label        String?  // "Home" | "Office" | "Other"
  deliveryNote String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@map("order_customer_details")
}

// OrderTransaction model - financial transaction records
model OrderTransaction {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paymentMethod String   // Dynamic string: "cod", "bkash", "nagad", "card", "upay", etc. (NO ENUM RESTRICTION)
  trxId         String?  // Transaction ID
  mfsNumber     String?  // Sender MFS phone number
  amount        Decimal  @db.Decimal(12, 2)
  status        String   @default("pending") // "pending" | "verified" | "rejected" | "paid" | "unpaid"
  note          String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
  @@index([trxId])
  @@map("order_transactions")
}

// ActivityLog model - system audit trail for administrative operations and store transparency
model ActivityLog {
  id          String           @id @default(uuid())
  timestamp   DateTime         @default(now())

  // Actor Information
  adminId     String?
  admin       Admin?           @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorName   String
  actorEmail  String
  actorRole   String
  actorAvatar String?

  // Action Details
  action      String           // e.g. "Updated Category", "Order Status Dispatched", "Verified bKash Payment"
  entity      String           // e.g. "Smartphones & Foldables", "Order #TC-94281", "Trx #9M48L912K"
  entityId    String?          // Optional ID or business code
  category    ActivityCategory @default(CATALOG)
  severity    ActivitySeverity @default(INFO)
  details     String           @db.Text // Human-readable audit narrative

  // Device & Network Origin
  ipAddress   String?          @default("127.0.0.1")
  device      String?          @default("Chrome / Windows 11")
  location    String?          @default("Dhaka, Bangladesh")

  // Optional Metadata (diffs, snapshots)
  metadata    Json?

  createdAt   DateTime         @default(now())

  @@index([category])
  @@index([severity])
  @@index([createdAt])
  @@index([adminId])
  @@index([entityId])
  @@map("activity_logs")
}


