// Prisma Schema for TelosCart E-Commerce Backend (https://www.teloscart.website/)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum AdminRole {
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AddressType {
  SHIPPING
  BILLING
}

// ==================== MODELS ====================

// Admin model - back-office administrators for TelosCart
model Admin {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      AdminRole  @default(SUPER_ADMIN)
  phone     String?
  avatar    String?
  status    UserStatus @default(ACTIVE)

  // Soft Delete Policy
  isDeleted Boolean    @default(false)
  deletedAt DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("admins")
}

// Customer model - shoppers and registered buyers for TelosCart
model Customer {
  id         String            @id @default(uuid())
  customerId String?           @unique // Unique business identifier e.g. TC-2026-1001
  name       String
  email      String            @unique
  password   String
  phone      String            @unique
  avatar     String?
  status     UserStatus        @default(ACTIVE)

  // E-commerce address relations
  addresses  CustomerAddress[]

  // Soft Delete Policy
  isDeleted  Boolean           @default(false)
  deletedAt  DateTime?

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("customers")
}

// CustomerAddress model - multi-address support for checkout & billing
model CustomerAddress {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String?     // Recipient Name
  phone      String?     // Recipient Phone
  title      String?     // e.g. "Home", "Office", "Other"
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  street     String
  city       String      // District
  area       String?     // Upazila
  union      String?     // Union
  zone       String?     // "inside-dhaka" | "outside-dhaka"
  state      String?
  postalCode String?
  country    String      @default("Bangladesh")

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

// Category model - product hierarchy for storefront navigation and catalog filtering
model Category {
  id                 String        @id @default(uuid())
  name               String
  slug               String     @unique
  description        String?
  icon               String?
  image              String?
  imageKey           String?
  subCategories      SubCategory[]
  isActive           Boolean    @default(true)
  isFeaturedHomepage Boolean    @default(false)

  // Soft Delete Policy
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([isActive, isDeleted])
  @@index([isFeaturedHomepage])
  @@map("categories")
}

// Brand model - manufacturer/vendor identities for storefront filtering and the
// "Official Brands" marquee. Flat hierarchy on purpose: brands have no children.
model Brand {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  tagline           String? // Official tagline supplied by the storefront form
  description       String?
  image             String?
  imageKey          String?
  isActive          Boolean  @default(true)
  isFeaturedMarquee Boolean  @default(false) // Featured in Official Brands Marquee

  // Soft Delete Policy
  isDeleted         Boolean  @default(false)
  deletedAt         DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, isDeleted])
  @@index([isFeaturedMarquee])
  @@map("brands")
}

// SubCategory model - child taxonomy under a main category
model SubCategory {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)

  // Soft Delete Policy
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive, isDeleted])
  @@map("sub_categories")
}
